// Config de zellij SOLO para divvy (se pasa con -c al lanzar).
//
// Clave del problema de "procesos zombie": por defecto zellij, al recibir
// SIGHUP/SIGTERM (p.ej. al cerrar Ghostty), hace DETACH y deja la sesion —con
// nvim, yazi y el agente— viva en segundo plano. Sesion tras sesion se
// acumulan. Con "quit" la sesion se cierra del todo y mata a sus procesos.
on_force_close "quit"

// Tampoco serializamos/resucitamos sesiones divvy: cada lanzamiento es limpio.
session_serialization false

// --- Saltar a un panel por numero ---------------------------------------
// zellij 0.44 NO tiene "foco por indice/nombre"; solo foco direccional. Pero
// el layout es fijo, asi que encadenamos MoveFocus (que NO hace wrap: se topa
// en el borde) para llegar SIEMPRE al panel correcto, vengas de donde vengas:
//
//   [ 1 archivos | 2 editor | 3 agente ]   (fila superior, 80%)
//   [          4 terminal           ]      (abajo, 20%, ancho completo)
//
//   1 archivos  = Up, Left, Left           (clava a la izquierda arriba)
//   2 editor    = Up, Left, Left, Right    (izquierda arriba y un paso a la der)
//   3 agente    = Up, Right, Right         (clava a la derecha arriba)
//   4 terminal  = Down                     (abajo solo hay un panel)
//
// OJO terminal: Ctrl+1..4 muchas terminales NO los mandan de forma unica
// (Ctrl+2=NUL, Ctrl+3=ESC, etc.). Por eso ALT+1..4 es lo fiable; dejamos
// tambien Ctrl+1..4 por si tu terminal (Ghostty con protocolo kitty) si los
// distingue. El foco direccional Alt+flechas / Alt+hjkl sigue siendo el default.
//
// --- Git graph modal (Alt+g) --------------------------------------------
// Opens keifu (a git commit-graph TUI) in a FLOATING pane, on top of the
// layout, like a modal you pop open to consult history and dismiss. keifu
// runs in the pane's cwd (the repo you launched divvy from). Quit it with
// q / Esc and close_on_exit makes the floating pane disappear. We call the
// divvy-git wrapper (not keifu directly) so a missing keifu shows a helpful
// message instead of an empty pane. NOTE: 'g' — not Ctrl+g — on purpose:
// Ctrl+g is micro's lock-mode key and a global bind would steal it.
keybinds {
    shared_except "locked" {
        bind "Alt 1" "Ctrl 1" { MoveFocus "Up"; MoveFocus "Left"; MoveFocus "Left"; }
        bind "Alt 2" "Ctrl 2" { MoveFocus "Up"; MoveFocus "Left"; MoveFocus "Left"; MoveFocus "Right"; }
        bind "Alt 3" "Ctrl 3" { MoveFocus "Up"; MoveFocus "Right"; MoveFocus "Right"; }
        bind "Alt 4" "Ctrl 4" { MoveFocus "Down"; }
        bind "Alt g" {
            Run "divvy-git" {
                floating true
                close_on_exit true
                name "git"
                // Big, centered modal (a small frame of the layout stays visible
                // around it). x/y = (100-size)/2 to center it.
                x "5%"
                y "7%"
                width "90%"
                height "85%"
            }
        }
        //
        // --- Tool windows: hide/show a pane like a JetBrains tool window --------
        // Alt+z zen-maximizes the FOCUSED pane (hide the rest; toggle back) — native.
        //
        // Per tool window, TWO keys (pure keybind actions, so they run in your client
        // where focus is reliable — a CLI script isn't):
        //   Alt+<key>        HIDE:  focus that pane (directionally, like Alt+1..4),
        //                          float it OUT so the rest reflow to fill, then hide
        //                          the floating layer. Its process keeps running.
        //   Alt+Shift+<key>  SHOW:  reveal the floating layer and embed the pane back
        //                          in place. (All three SHOW binds do the same thing;
        //                          they restore whichever tool window is hidden.)
        // Direction sequences mirror the Alt+1..4 nav above. Note: pressing a SHOW key
        // with nothing hidden opens a stray floating pane (zellij behavior) — just
        // press it again / close it.
        bind "Alt z" { ToggleFocusFullscreen; }
        // files (top-left)
        bind "Alt b" { MoveFocus "Up"; MoveFocus "Left"; MoveFocus "Left"; TogglePaneEmbedOrFloating; ToggleFloatingPanes; }
        bind "Alt B" { ToggleFloatingPanes; TogglePaneEmbedOrFloating; }
        // agent (top-right)
        bind "Alt a" { MoveFocus "Up"; MoveFocus "Right"; MoveFocus "Right"; TogglePaneEmbedOrFloating; ToggleFloatingPanes; }
        bind "Alt A" { ToggleFloatingPanes; TogglePaneEmbedOrFloating; }
        // terminal (bottom)
        bind "Alt t" { MoveFocus "Down"; TogglePaneEmbedOrFloating; ToggleFloatingPanes; }
        bind "Alt T" { ToggleFloatingPanes; TogglePaneEmbedOrFloating; }
    }
}
